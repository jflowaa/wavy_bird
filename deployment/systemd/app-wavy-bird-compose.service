[Unit]
Description=wavy-bird compose stack
Wants=network-online.target
After=network-online.target platform-compose.service
Requires=platform-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/wavy-bird
ExecStart=/usr/bin/podman-compose -p wavy-bird up -d --remove-orphans
ExecStop=/usr/bin/podman-compose -p wavy-bird down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
